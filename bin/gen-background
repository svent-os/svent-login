#!/usr/bin/python3
import argparse
from pathlib import Path
from PIL import Image

def stage(source, output):
    with Image.open(source) as image:
        image.load()
        if image.format != "PNG" or image.size != (5120, 2880):
            raise ValueError("The login background must be a 5120x2880 PNG")
        output.parent.mkdir(parents=True, exist_ok=True)
        temporary = output.with_suffix(".tmp")
        image.convert("RGB").save(temporary, format="PNG", compress_level=6)
        temporary.replace(output)

def main():
    root = Path(__file__).resolve().parent.parent
    parser = argparse.ArgumentParser()
    parser.add_argument("--out", type=Path, default=root / "assets/background.png")
    args = parser.parse_args()
    stage(root / "exports/login-background.png", args.out)

if __name__ == "__main__":
    main()
