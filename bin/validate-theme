#!/usr/bin/python3
from pathlib import Path
import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk

root = Path(__file__).resolve().parent.parent
Gtk.init([])
provider = Gtk.CssProvider()
css = (root / "themes/svent/gtk.css").read_text()
css = css.replace("/usr/share/svent/login/background.png", (root / "assets/background.png").as_posix())
provider.load_from_data(css.encode())
builder = Gtk.Builder()
builder.add_from_file(str(root / "themes/svent/greeter-gtk3.ui"))
for name in ("lxdm", "prompt", "login_entry", "user_list", "sessions", "lang", "keyboard", "exit", "time", "bottom_pane"):
    if builder.get_object(name) is None:
        raise ValueError("Missing LXDM widget: " + name)
Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
window = builder.get_object("lxdm")
builder.get_object("time").set_text("22:33")
builder.get_object("login_entry").set_text("SventOS")
window.set_default_size(1280, 720)
window.show_all()
for name in ("image1", "user_list_scrolled"):
    builder.get_object(name).hide()
while Gtk.events_pending():
    Gtk.main_iteration()
allocation = window.get_allocation()
footer = builder.get_object("bottom_pane").get_allocation()
entry = builder.get_object("login_entry")
position = entry.translate_coordinates(window, 0, 0)
footer_position = builder.get_object("bottom_pane").translate_coordinates(window, 0, 0)
if footer.height > allocation.height / 4 or position[1] < 0 or position[1] + entry.get_allocated_height() > footer_position[1]:
    raise ValueError("Invalid login layout: stretched footer or obscured login form")
window.destroy()
print("Validated GTK3 greeter, stylesheet and allocated login layout")
