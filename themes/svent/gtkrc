style "default" {
  GtkWidget::focus-line-width = 0
  GtkWidget::focus-padding = 0
  fg[NORMAL] = "#d7dee7"
  fg[ACTIVE] = "#d7dee7"
  fg[PRELIGHT] = "#ffffff"
  fg[SELECTED] = "#ffffff"
  fg[INSENSITIVE] = "#7e8995"
  text[NORMAL] = "#e5e9ef"
  text[ACTIVE] = "#e5e9ef"
  text[SELECTED] = "#ffffff"
  base[NORMAL] = "#191d22"
  base[ACTIVE] = "#242a2e"
  base[SELECTED] = "#943c40"
  bg[NORMAL] = "#343b43"
  bg[ACTIVE] = "#242a2e"
  bg[PRELIGHT] = "#302427"
  bg[SELECTED] = "#943c40"
  font_name = "Sans 11"
}
class "*" style : highest "default"
style "entry" {
  xthickness = 2
  ythickness = 8
  bg[NORMAL] = "#ff6266"
  bg[ACTIVE] = "#ff6266"
  font_name = "Sans 13"
}
style "footer" {
  fg[NORMAL] = "#b3bdc7"
  font_name = "Sans 10"
}
widget "*.login_entry" style : highest "entry"
widget "*.bottom_pane.*" style : highest "footer"
